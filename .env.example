# Auth0 Configuration
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_API_AUDIENCE=https://your-api-audience
AUTH0_ALGORITHMS=RS256
AUTH0_MANAGEMENT_CLIENT_ID=your-management-client-id
AUTH0_MANAGEMENT_CLIENT_SECRET=your-management-client-secret
AUTH0_MANAGEMENT_AUDIENCE=https://your-tenant.auth0.com/api/v2/
AUTH0_CONNECTION_ID=your-connection-id
AUTH0_CUSTOMER_ROLE=Customer
AUTH0_ADMIN_ROLE=Admin

# Database Configuration (PostgreSQL)
# En local apunta al contenedor de docker-compose (localhost:5432).
# La app se conecta como mt_app (rol NO superusuario) para que el RLS aísle por taller.
# El contenedor crea mt_app automáticamente en el primer arranque (db/init/00_roles.sql).
DB_HOST=localhost
DB_PORT=5432
DB_USER=mt_app
DB_PASSWORD=test123
DB_NAME=motogestion

# Application Configuration
environment=development
project_name=Iluma Orders API
allowed_origin=http://localhost:3000
frontend_url=http://localhost:3000

# --- Wompi (pasarela de pagos; opcional hasta que se configure) ---
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
WOMPI_BASE_URL=https://sandbox.wompi.co/v1

# --- Sentry (monitoreo de errores; opcional, vacío = deshabilitado) ---
# Dejar vacío en desarrollo para no mandar ruido local al proyecto de Sentry.
SENTRY_DSN=
