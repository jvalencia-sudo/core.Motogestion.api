# ──────────────────────────────────────────────────────────────
# Plantilla del .env de PRODUCCIÓN (VM de Oracle Cloud).
# En la VM: copiar a ~/app/.env, rellenar y `chmod 600 .env`.
# NO commitear el .env real (está en .gitignore).
#
# Genera secretos así (solo hex/alfanumérico: la app arma el DSN de Postgres sin
# comillas, así que evita espacios, comillas y símbolos en las contraseñas de BD):
#   openssl rand -hex 24      # contraseñas de BD
#   openssl rand -hex 32      # N8N_ENCRYPTION_KEY
# ──────────────────────────────────────────────────────────────

# Hace que `docker compose up -d` use el compose de producción y no el de desarrollo.
COMPOSE_FILE=docker-compose.prod.yml

# --- Postgres: superusuario (solo administración y backups; el backend NO lo usa) ---
POSTGRES_USER=pgadmin
POSTGRES_PASSWORD=
POSTGRES_DB=motogestion

# --- Postgres: rol de la app (no superusuario, dueño del schema; el RLS aplica) ---
APP_DB_USER=mt_app
APP_DB_PASSWORD=

# --- Postgres: BD y usuario de n8n (separados de los de la app) ---
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=

# --- n8n ---
# GUÁRDALA en un gestor de contraseñas: si se pierde, n8n no puede descifrar las
# credenciales guardadas. No la cambies después de crear credenciales.
N8N_ENCRYPTION_KEY=
# Recomendado fijar una versión concreta (ej. 1.x.y) para que un `pull` no te actualice solo.
N8N_VERSION=latest

# --- Backend ---
# "prod" oculta /docs (Swagger). Usa "dev" temporalmente si quieres verlo.
ENVIRONMENT=prod
PROJECT_NAME=moto-api
# CORS: orígenes permitidos separados por comas, con https y SIN "/" final.
# Pon aquí el dominio de tu front en Vercel. Los previews (*.vercel.app con hash)
# NO quedan cubiertos: añádelos a mano si los necesitas.
CORS_ORIGINS=https://TU-PROYECTO.vercel.app
# URL base del front (redirect de pagos, enlaces en correos).
FRONTEND_URL=https://TU-PROYECTO.vercel.app

# --- Auth0 ---
AUTH0_DOMAIN=
AUTH0_API_AUDIENCE=
AUTH0_ALGORITHMS=RS256
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=
AUTH0_MANAGEMENT_AUDIENCE=
AUTH0_CONNECTION_ID=Username-Password-Authentication
AUTH0_CUSTOMER_ROLE=
AUTH0_ADMIN_ROLE=

# --- Backups fuera de la VM (scripts/backup_postgres.sh) ---
# Pre-Authenticated Request de Oracle Object Storage con permiso "Permit object
# writes" (SOLO escritura, sin lectura/listado/borrado) sobre el bucket de backups.
# Se genera en la consola OCI: Object Storage → bucket → Pre-Authenticated Requests
# → Create. Vence, hay que renovarla antes (recomendado: 1 año).
BACKUP_PAR_URL=
# Ping de Healthchecks.io: se llama al terminar el backup con éxito. Si un día no
# llega, Healthchecks.io avisa por correo. https://healthchecks.io → New Check.
BACKUP_HEALTHCHECK_URL=

# --- Wompi (pasarela de pagos; opcional, déjalo vacío si aún no lo usas) ---
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
WOMPI_BASE_URL=https://sandbox.wompi.co/v1
